# Copy this file to .env and fill in values before running docker-compose

# Database
DB_USERNAME=postgres
DB_PASSWORD=yourpassword

# JWT — generate a strong base64-encoded 256-bit key for production
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# DCU integration: REST or MQTT
DCU_INTEGRATION_MODE=REST

# MQTT broker (only needed when DCU_INTEGRATION_MODE=MQTT)
MQTT_BROKER_URL=tcp://mosquitto:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000
