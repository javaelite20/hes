<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="001-create-users-table" author="smartmonitoring">

        <createTable tableName="users" remarks="Application users — residents and admins">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="pk_users" nullable="false"/>
            </column>

            <!-- Unique login identifier.
                 Residents : towerNumber_flatNumber  (e.g. "01_A-101")
                 Admins    : email address           (e.g. "admin@society.com") -->
            <column name="user_id" type="VARCHAR(100)"
                    remarks="Unique login identifier">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_users_userid"/>
            </column>

            <column name="password" type="VARCHAR(255)" remarks="BCrypt hashed password">
                <constraints nullable="false"/>
            </column>

            <column name="name" type="VARCHAR(255)" remarks="Full name of the user">
                <constraints nullable="false"/>
            </column>

            <column name="phone_number" type="VARCHAR(20)" remarks="Contact number"/>

            <column name="role" type="VARCHAR(20)" remarks="RESIDENT or ADMIN">
                <constraints nullable="false"/>
            </column>

            <column name="tower_number" type="VARCHAR(50)"
                    remarks="Tower/block identifier for residents (e.g. 01, A, B)"/>

            <column name="flat_number" type="VARCHAR(50)"
                    remarks="Flat or unit identifier in the society"/>

            <!-- Email retained for admins; optional for residents -->
            <column name="email" type="VARCHAR(255)" remarks="Contact email (optional for residents)"/>

            <column name="created_at" type="TIMESTAMP WITHOUT TIME ZONE" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="TIMESTAMP WITHOUT TIME ZONE" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <!-- Index on user_id for fast auth lookups -->
        <createIndex tableName="users" indexName="idx_users_userid">
            <column name="user_id"/>
        </createIndex>

        <!-- Enforce role values at DB level -->
        <sql>
            ALTER TABLE users
                ADD CONSTRAINT chk_users_role CHECK (role IN ('RESIDENT', 'ADMIN'));
        </sql>

    </changeSet>

</databaseChangeLog>
