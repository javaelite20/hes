<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="003-create-meter-readings-table" author="smartmonitoring">

        <!--
            Raw readings pushed by the DCU via MQTT.
            High-volume table — one row per reading per meter (e.g. every 15 min = ~100 rows/day/meter).
            Indexed heavily on (meter_id, recorded_at) for range queries.
        -->
        <createTable tableName="meter_readings"
                     remarks="Raw time-series readings ingested from DCU via MQTT">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="pk_meter_readings" nullable="false"/>
            </column>

            <column name="meter_id" type="BIGINT" remarks="FK to meters table">
                <constraints nullable="false"/>
            </column>

            <!--
                Cumulative odometer-style kWh value at the time of this reading.
                NUMERIC(12,4) supports up to 99,999,999.9999 kWh.
            -->
            <column name="kwh_value" type="NUMERIC(12,4)"
                    remarks="Cumulative kWh reading (odometer style) from the meter">
                <constraints nullable="false"/>
            </column>

            <!--
                Instantaneous load in watts at the time of the reading.
                NUMERIC(10,2) supports up to 99,999,999.99 W.
            -->
            <column name="instant_power_watts" type="NUMERIC(10,2)"
                    remarks="Instantaneous power consumption in watts at time of reading"/>

            <!-- Timestamp as reported by the DCU firmware (device time) -->
            <column name="recorded_at" type="TIMESTAMP WITHOUT TIME ZONE"
                    remarks="Timestamp as reported by the DCU device">
                <constraints nullable="false"/>
            </column>

            <!-- Timestamp when we received and persisted the message -->
            <column name="received_at" type="TIMESTAMP WITHOUT TIME ZONE"
                    defaultValueComputed="NOW()"
                    remarks="Server-side timestamp when the reading was persisted">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <!-- FK: reading → meter -->
        <addForeignKeyConstraint
                baseTableName="meter_readings"
                baseColumnNames="meter_id"
                constraintName="fk_meter_readings_meter"
                referencedTableName="meters"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <!--
            Composite index on (meter_id, recorded_at) — the primary query pattern
            for fetching readings in a time range for a specific meter.
        -->
        <createIndex tableName="meter_readings"
                     indexName="idx_meter_readings_meter_recorded"
                     unique="false">
            <column name="meter_id"/>
            <column name="recorded_at"/>
        </createIndex>

        <!-- Standalone index on recorded_at for global time-range queries (admin use) -->
        <createIndex tableName="meter_readings" indexName="idx_meter_readings_recorded_at">
            <column name="recorded_at"/>
        </createIndex>

        <!-- Guard: kwh_value must always be non-negative -->
        <sql>
            ALTER TABLE meter_readings
                ADD CONSTRAINT chk_meter_readings_kwh_positive CHECK (kwh_value >= 0);
        </sql>

    </changeSet>

</databaseChangeLog>
